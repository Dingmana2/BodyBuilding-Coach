# Get your key at: https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...

# App environment
APP_ENV=production

# JWT signing secret — generate with:
#   python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# KEEP THIS SECRET — changing it invalidates all existing login sessions
SECRET_KEY=your-random-secret-here

# Shared secret between the web app and Telegram bot (generate same way as SECRET_KEY)
# Required to enable /link command and bot-to-API calls. Set the same value in both services.
BOT_SECRET=your-bot-secret-here

# Base URL where the FastAPI app is accessible FROM the bot's network
# On Railway: set this to your web service's public URL (e.g. https://myapp.railway.app)
API_BASE_URL=http://localhost:8000
