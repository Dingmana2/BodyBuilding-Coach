# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key — get yours at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# JWT signing secret for the web app — generate with:
#   python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# KEEP THIS SECRET — changing it invalidates all existing login sessions
SECRET_KEY=your-random-secret-here

# Shared secret between web app and Telegram bot (generate same way as SECRET_KEY)
# Must be identical in both the API server and the bot process
BOT_SECRET=your-bot-secret-here

# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-your-token-here

# ── Optional ──────────────────────────────────────────────────────────────────

# SQLAlchemy database URL
# Default (SQLite, single file, zero config): sqlite:///./fitness_coach.db
# PostgreSQL (Railway, Supabase, etc.):       postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./fitness_coach.db

# Base URL of the FastAPI server, reachable from the bot's network
# Local dev: http://localhost:8000   Railway/cloud: https://your-app.railway.app
API_BASE_URL=http://localhost:8000

# Directory where uploaded photos are stored
# Defaults to the repo root if not set
DATA_DIR=/data

# Stripe secret key for subscription billing (optional — billing UI degrades gracefully without it)
STRIPE_SECRET_KEY=sk_live_...

# App environment tag (used for logging/APM)
APP_ENV=production
